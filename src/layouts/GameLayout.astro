---
// ゲームのページ共通の枠。左にサイドメニュー（物語・登場人物・考察）、右に本文。
// スマホではサイドメニューを画面上部の横スクロールのタブにする
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import RightsNotice from '../components/RightsNotice.astro';
import { groupBySection, slugOf } from '../lib/content';
import { url, file } from '../lib/url';
import { getEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
  pages: CollectionEntry<'pages'>[];
  current?: string;
  title: string;
  description?: string;
}
const { game, pages, current, title, description } = Astro.props;
const groups = groupBySection(pages);
const hubHref = url(`games/${game.id}`);
// サイドメニューの「作品」: 考察の下に、作品の画像（titles[].cover）を並べる。押すとトップの作品一覧のカードへ移る
const assets = new Map(((await getEntry('assets', game.id))?.data.assets ?? []).map((a) => [a.id, a]));
const works = game.data.titles.map((t) => ({ ...t, img: t.cover ? assets.get(t.cover) : undefined }));
// 作品1本の物語のページ（frontmatter の work）には、その作品の画像を正方形に切り取ったサムネイルを付ける
const thumbOf = (work?: string) => { const w = works.find((x) => x.id === work); return w?.img ? file(`games/${game.id}/${w.img.file}`) : undefined; };
---
<Base title={title} description={description}>
  <div class={`game-shell lane-${game.data.color}`}>
    <nav class="side" aria-label={`${game.data.title} のページ`}>
      <a class:list={['side-game', !current && 'is-current']} href={hubHref} aria-current={!current ? 'page' : undefined}>
        <Icon icon={game.data.icon} size="1.5rem" />
        <span>{game.data.title}<small>{game.data.title_ja}</small></span>
      </a>
      {groups.map((sec) => (
        <div class="side-group">
          <div class="side-label"><Icon icon={sec.icon} size="1rem" />{sec.label}</div>
          <ul>
            {sec.pages.map((p) => {
              const here = slugOf(p.id) === current;
              const th = thumbOf(p.data.work);
              return <li><a class:list={[here && 'is-current', th && 'has-thumb']} href={url(`games/${game.id}/${slugOf(p.id)}`)} aria-current={here ? 'page' : undefined}>{th && <img class="side-thumb" src={th} alt="" width="28" height="28" loading="lazy" />}<span>{p.data.title}</span></a></li>;
            })}
          </ul>
        </div>
      ))}
      {works.length > 0 && (
        <div class="side-group side-works">
          <div class="side-label"><Icon icon="lucide:library" size="1rem" />作品</div>
          <ul>
            {works.map((w) => (
              <li><a href={`${hubHref}#work-${w.id}`} title={w.label}>
                {w.img ? <img src={file(`games/${game.id}/${w.img.file}`)} alt="" width="230" height="108" loading="lazy" /> : <span class="no-img"><Icon icon={game.data.icon} size="1.25rem" /></span>}
                <span class="w-label">{w.label}</span>
              </a></li>
            ))}
          </ul>
        </div>
      )}
    </nav>
    <div class="main-col">
      <slot />
      <RightsNotice game={game} />
    </div>
  </div>
</Base>
<style>
  .game-shell { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .side { position: sticky; top: var(--space-6); max-height: calc(100vh - var(--footer-h) - var(--space-12)); overflow-y: auto;
          display: flex; flex-direction: column; gap: var(--space-6); padding-right: var(--space-2); }
  .side-game { display: flex; align-items: center; gap: var(--space-3); color: var(--color-ink); text-decoration: none; font-weight: 700; line-height: 1.3;
               padding: var(--space-2) var(--space-3); border-radius: var(--radius); }
  .side-game :global(.icon) { color: var(--lane); }
  .side-game small { display: block; font-weight: 400; font-size: 0.8125rem; color: var(--color-muted); }
  .side-label { display: flex; align-items: center; gap: var(--space-2); font-size: 0.8125rem; font-weight: 700; color: var(--color-muted); padding: 0 var(--space-3) var(--space-2); }
  .side ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .side li a { display: block; padding: var(--space-2) var(--space-3); border-radius: var(--radius); color: var(--color-ink); text-decoration: none; font-size: var(--text-small); line-height: 1.5; }
  .side a:hover { background: var(--color-surface); }
  .side a.is-current { background: var(--color-surface); font-weight: 700; box-shadow: inset 0 0 0 1px var(--color-rule); }

  .side li a.has-thumb { display: flex; align-items: center; gap: var(--space-2); }
  .side-thumb { flex: none; width: 28px; height: 28px; aspect-ratio: 1; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-rule); }
  .side-works ul { gap: var(--space-2); }
  .side-works li a { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-1) var(--space-3) var(--space-2); }
  .side-works img, .side-works .no-img { display: block; width: 100%; height: auto; aspect-ratio: 460 / 215; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-rule); }
  .side-works .no-img { display: flex; align-items: center; justify-content: center; background: var(--color-surface); color: var(--lane); }
  .side-works .w-label { font-size: 0.8125rem; color: var(--color-muted); line-height: 1.4; }

  /* スマホ・狭い画面: サイドメニューを上部の横スクロールのタブにする */
  @media (max-width: 60rem) {
    :global(main) { padding-top: 0; }
    .game-shell { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .side { position: sticky; top: 0; z-index: 15; max-height: none; flex-direction: row; align-items: stretch; gap: var(--space-1);
            overflow-x: auto; overflow-y: hidden; margin: 0 calc(var(--page-pad) * -1); padding: var(--space-2) var(--page-pad);
            background: var(--color-bg); border-bottom: 1px solid var(--color-rule); scrollbar-width: none; }
    .side::-webkit-scrollbar { display: none; }
    .side-game small { display: none; }
    .side-label { flex: none; align-self: center; padding: 0 var(--space-1) 0 var(--space-3); margin-left: var(--space-2); border-left: 1px solid var(--color-rule); letter-spacing: 0; }
    .side-label :global(.icon) { display: none; }
    .side-group, .side ul { display: contents; }
    .side-game, .side li a { flex: none; white-space: nowrap; padding: var(--space-2) var(--space-3); border-radius: var(--radius); }
    .side li { display: contents; }
    .side-works img, .side-works .no-img { display: none; }
    .side-thumb { width: 20px; height: 20px; }
    .side-works li a { flex-direction: row; padding: var(--space-2) var(--space-3); }
    .side-works .w-label { font-size: var(--text-small); color: var(--color-ink); }
  }
</style>
