---
import '../styles/global.css';
import { url } from '../lib/url';
import { iconSvg } from '../lib/icons';

interface Props { title: string; description?: string }
const { title, description = 'ゲームの物語と考察を、少ない文字と簡単な図で整理するサイト' } = Astro.props;
const site = 'Yokai Game Lore';
const full = title === site ? site : `${title} | ${site}`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111318" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>
    <header class="site">
      <a class="brand" href={url()}><span class="mark" set:html={iconSvg('gi:scroll-unfurled', '1.4em')} />Yokai Game Lore</a>
      <nav aria-label="サイト">
        <a href={url('about')}>About</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site">
      <a href={url('credits')}><span class="fi" set:html={iconSvg('lucide:copyright')} />クレジット</a>
      <a href="https://github.com/ystk-kai/yokai-game-lore" rel="noopener"><span class="fi" set:html={iconSvg('lucide:github')} />GitHub</a>
    </footer>
  </body>
</html>
<style is:global>
  /* 横のはみ出しを切る。hidden にすると sticky（サイドメニュー）が効かなくなるので clip にする */
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
<style>
  .skip { position: absolute; left: -999px; } .skip:focus { left: var(--space-4); top: var(--space-2); z-index: 10; background: var(--color-surface); padding: var(--space-2); }
  header.site { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); padding: var(--space-3) var(--page-pad); border-bottom: 1px solid var(--color-rule); background: var(--color-surface); }
  .brand { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; color: var(--color-ink); text-decoration: none; letter-spacing: 0.02em; }
  .mark { color: var(--color-accent); line-height: 0; }
  nav { display: flex; gap: var(--space-4); font-size: var(--text-small); }
  nav a { color: var(--color-muted); text-decoration: none; } nav a:hover { color: var(--color-ink); }
  main { padding: var(--space-8) var(--page-pad) calc(var(--footer-h) + var(--space-12)); max-width: var(--page-max); margin: 0 auto; }
  /* フッターは1行で画面の下に固定（作者の決定） */
  footer.site { position: fixed; inset: auto 0 0 0; z-index: 20; height: var(--footer-h); display: flex; align-items: center; gap: var(--space-6);
    padding: 0 var(--page-pad); background: var(--color-surface); border-top: 1px solid var(--color-rule); font-size: var(--text-small); color: var(--color-muted); }
  footer.site a { color: var(--color-muted); text-decoration: none; } footer.site a:hover { color: var(--color-ink); }
  footer.site a { display: inline-flex; align-items: center; gap: var(--space-1); }
  .fi { line-height: 0; }
</style>
