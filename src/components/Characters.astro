---
// 人物・クリーチャーの名鑑。<Characters game="reanimal" kind="creature" /> のように種類で絞れる
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Evidence from './Evidence.astro';
import Sources from './Sources.astro';
import { file } from '../lib/url';

interface Props { game: string; kind?: 'protagonist' | 'ally' | 'creature' | 'other'; only?: string[]; appearsIn?: string }
const { game, kind, only, appearsIn } = Astro.props;
const entry = await getEntry('characters', game);
const assets = new Map(((await getEntry('assets', game))?.data.assets ?? []).map((a) => [a.id, a]));
const img = (id?: string) => { const a = id ? assets.get(id) : undefined; return a ? { src: file(`games/${game}/${a.file}`), alt: a.alt, credit: a.credit, source: a.source_url } : undefined; };
if (!entry) throw new Error(`characters.yaml が無い: ${game}`);
const list = entry.data.characters.filter((c) => (!kind || c.kind === kind) && (!only || only.includes(c.id)) && (!appearsIn || c.appears_in.includes(appearsIn)));
const kindLabel = { protagonist: '主人公', ally: '仲間', creature: 'クリーチャー', other: 'その他' } as const;
---
<ul class="cards">
  {list.map((c) => {
    const thumb = img(c.image?.thumb);
    const wide = img(c.image?.wide);
    return (
      <li class={`card kind-${c.kind}`} id={`ch-${c.id}`}>
        {wide && (
          <figure class="wide">
            <img src={wide.src} alt={wide.alt} loading="lazy" width="1168" height="368" />
            <figcaption title={wide.credit}>画像の出典: {wide.source ? <a href={wide.source} rel="noopener">{c.looks_label ?? '出典ページ'}</a> : (c.looks_label ?? '')}</figcaption>
          </figure>
        )}
        <div class="head">
          {thumb
            ? <img class="pic-img" src={thumb.src} alt={thumb.alt} loading="lazy" width="150" height="150" />
            : c.icon ? <Icon icon={c.icon} game={game} size="3.5rem" class="pic" label={c.name} /> : <span class="pic-empty" aria-hidden="true"></span>}
          <div>
            <div class="kind">{kindLabel[c.kind]}</div>
            <h3>{c.name}</h3>
            {c.name_en && <div class="en" lang="en">{c.name_en}</div>}
            <div class="role">{c.role}</div>
          </div>
        </div>
        {c.looks && <p><span class="k">見た目</span>{c.looks}</p>}
        {!wide && c.looks_url && <p class="looks-link"><a href={c.looks_url} rel="noopener" target="_blank">見た目の画像を見る（{c.looks_label ?? '外部サイト'}）↗</a></p>}
        {c.first_seen && <p><span class="k">初登場</span>{c.first_seen}</p>}
        {c.secret && <p><span class="k">正体・結末</span>{c.secret}</p>}
        <div class="foot"><Evidence level={c.evidence} /><Sources sources={c.sources} /></div>
      </li>
    );
  })}
</ul>
<style>
  .cards { list-style: none; padding: 0; margin: var(--space-6) 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: var(--space-4); }
  .card { overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius); padding: var(--space-4); font-size: var(--text-small); line-height: 1.65; }
  .kind-protagonist { --k: var(--lane-l2); } .kind-ally { --k: var(--lane-l3); } .kind-creature { --k: var(--lane-l1); } .kind-other { --k: var(--color-muted); }
  .head { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-2); }
  :global(.pic) { color: var(--k); }
  .wide { margin: calc(var(--space-4) * -1) calc(var(--space-4) * -1) var(--space-3); }
  .wide img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 5; object-fit: cover; }
  .wide figcaption { font-size: 0.8125rem; color: var(--color-muted); padding: var(--space-1) var(--space-4) 0; }
  .pic-img { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; flex: none; border: 2px solid var(--k); }
  .looks-link { font-weight: 700; }
  .pic-empty { width: 3.5rem; height: 3.5rem; border-radius: 50%; border: 2px dashed var(--color-rule); flex: none; }
  .kind { font-size: 0.8125rem; color: var(--k); font-weight: 700; }
  h3 { margin: 0; font-size: var(--text-body); line-height: 1.35; }
  .en { color: var(--color-muted); font-size: var(--text-small); line-height: 1.3; }
  .role { color: var(--color-muted); }
  p { margin: var(--space-1) 0; line-break: strict; }
  .k { display: inline-block; font-weight: 700; margin-right: var(--space-2); color: var(--color-muted); }
  .foot { margin-top: var(--space-2); display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; }
</style>
