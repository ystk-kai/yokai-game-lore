---
// 物語の流れ（フローチャート）。場面をカードにして格子に置き、矢印で結ぶ。
// 座標は固定の格子なので、文字幅を推定しない: カードは幅と高さが固定で、あらすじは5行まで（全文は下の一覧）。
import type { z } from 'astro/zod';
import type { flowDiagram } from '../../schema';
import Icon from '../Icon.astro';
import Evidence from '../Evidence.astro';
import Sources from '../Sources.astro';

interface Props { data: z.infer<typeof flowDiagram>; game: string; id: string }
const { data, game, id } = Astro.props;

// カードの横の間（COL - W）は矢印のラベル用に 96px 空ける。横の矢印のラベルは2行まで、縦の矢印のラベルは1行
const COL = 352, ROW = 296, W = 256, H = 240, PAD = 24;
const cols = Math.max(...data.nodes.map((n) => n.at[0])) + 1;
const rows = Math.max(...data.nodes.map((n) => n.at[1])) + 1;
const width = PAD * 2 + (cols - 1) * COL + W;
const height = PAD * 2 + (rows - 1) * ROW + H;
const pos = (at: [number, number]) => ({ x: PAD + at[0] * COL, y: PAD + at[1] * ROW });
const laneOf = new Map(data.lanes.map((l) => [l.id, l]));
const nodeOf = new Map(data.nodes.map((n) => [n.id, n]));
const number = new Map(data.nodes.map((n, i) => [n.id, i + 1]));
const anchor = id.replace('/', '-');

const edges = data.edges.map((e) => {
  const a = nodeOf.get(e.from), b = nodeOf.get(e.to);
  if (!a || !b) throw new Error(`${id}: edge ${e.from}→${e.to} の場面が無い`);
  const p = pos(a.at), q = pos(b.at);
  let d: string, mid: { x: number; y: number };
  if (a.at[0] === b.at[0]) {
    // 同じ列: 縦に結ぶ
    const x = p.x + W / 2, down = q.y > p.y;
    const y1 = down ? p.y + H : p.y, y2 = down ? q.y - 2 : q.y + H + 2;
    d = `M${x},${y1} L${x},${y2}`; mid = { x, y: (y1 + y2) / 2 };
    return { ...e, d, mid, vertical: true };
  } else {
    // 右へ進むときは右端→左端、左へ戻るとき（折り返しの段）は左端→右端
    const right = q.x > p.x;
    const x1 = right ? p.x + W : p.x, y1 = p.y + H / 2, x2 = right ? q.x - 2 : q.x + W + 2, y2 = q.y + H / 2, cx = (x1 + x2) / 2;
    d = y1 === y2 ? `M${x1},${y1} L${x2},${y2}` : `M${x1},${y1} C${cx},${y1} ${cx},${y2} ${x2},${y2}`;
    mid = { x: cx, y: (y1 + y2) / 2 };
  }
  return { ...e, d, mid, vertical: false };
});
const kindLabel = { scene: '', start: '始まり', boss: '対決', ending: '結末', branch: '分岐' } as const;
// スマホ用の縦の並び: データの順に並べ、隣どうしをつなぐ矢印のラベルを間に出す
const edgeBetween = (a: string, b: string) => edges.find((e) => e.from === a && e.to === b);
const kindTag = (n: (typeof data.nodes)[number]) => (kindLabel[n.kind] && kindLabel[n.kind] !== n.sub ? kindLabel[n.kind] : '');
---
<figure class="flow">
  <figcaption>
    <span class="title">{data.title}</span>
    {data.caption && <span class="caption">{data.caption}</span>}
    <span class="lanes">
      {data.lanes.map((l) => <span class={`lane-chip lane-${l.color}`}><span class="swatch" aria-hidden="true"></span>{l.label}</span>)}
    </span>
  </figcaption>
  <div class="scroller" tabindex="0" aria-label={`${data.title}（横にスクロールできます）`}>
    <div class="canvas" style={`width:${width}px;height:${height}px`}>
      <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
        <defs>
          <marker id={`arrow-${anchor}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class="arrow-head" />
          </marker>
        </defs>
        {edges.map((e) => (
          <path d={e.d} class:list={['link', e.evidence === 'speculation' && 'is-spec']} marker-end={`url(#arrow-${anchor})`} />
        ))}
      </svg>
      {edges.filter((e) => e.label).map((e) => (
        <span class:list={['edge-label', e.vertical && 'is-vertical', e.evidence === 'speculation' && 'is-spec']} style={`left:${e.mid.x}px;top:${e.mid.y}px`}>{e.label}{e.evidence === 'speculation' && '？'}</span>
      ))}
      {data.nodes.map((n) => {
        const p = pos(n.at);
        const lane = laneOf.get(n.lane);
        if (!lane) throw new Error(`${id}: 場面 ${n.id} の lane「${n.lane}」が無い`);
        return (
          <article class:list={['scene', `lane-${lane.color}`, `kind-${n.kind}`, n.evidence === 'speculation' && 'is-spec']}
                   style={`left:${p.x}px;top:${p.y}px;width:${W}px;height:${H}px`}>
            <header>
              <a class="no num" href={`#${anchor}-${n.id}`} aria-label={`${number.get(n.id)}: 出典へ`}>{number.get(n.id)}</a>
              {n.icon && <Icon icon={n.icon} game={game} size="1.5em" class="sc-icon" />}
              {n.sub && <span class="sc-sub">{n.sub}</span>}
              {kindTag(n) && <span class="sc-kind">{kindTag(n)}</span>}
            </header>
            <h4>{n.label}</h4>
            <p class="sc-lane"><span class="sq" aria-hidden="true"></span>{lane.label}</p>
            {n.detail && <p class="sc-detail">{n.detail}</p>}
          </article>
        );
      })}
    </div>
  </div>
  <ol class="flow-list" aria-label={data.title}>
    {data.nodes.map((n, i) => {
      const lane = laneOf.get(n.lane)!;
      const next = data.nodes[i + 1];
      const e = next && edgeBetween(n.id, next.id);
      const branches = edges.filter((x) => x.from === n.id && (!next || x.to !== next.id));
      return (
        <li>
          <article class:list={['scene', 'is-static', `lane-${lane.color}`, `kind-${n.kind}`, n.evidence === 'speculation' && 'is-spec']}>
            <header>
              <span class="no num">{number.get(n.id)}</span>
              {n.icon && <Icon icon={n.icon} game={game} size="1.5em" class="sc-icon" />}
              {n.sub && <span class="sc-sub">{n.sub}</span>}
              {kindTag(n) && <span class="sc-kind">{kindTag(n)}</span>}
            </header>
            <h4>{n.label}</h4>
            <p class="sc-lane"><span class="sq" aria-hidden="true"></span>{lane.label}</p>
            {n.detail && <p class="sc-detail">{n.detail}</p>}
            {branches.map((b) => <p class="sc-branch">→ {nodeOf.get(b.to)!.label}{b.label && `（${b.label}）`}</p>)}
          </article>
          {next && <div class:list={['down', e?.evidence === 'speculation' && 'is-spec']} aria-hidden={!e?.label}>{e ? <>↓{e.label && <span>{e.label}</span>}</> : '·'}</div>}
        </li>
      );
    })}
  </ol>
  <details class="stops">
    <summary>場面ごとの全文と出典</summary>
    <ol>
      {data.nodes.map((n) => (
        <li id={`${anchor}-${n.id}`} class={`lane-${laneOf.get(n.lane)!.color}`}>
          <div class="stop-head"><span class="no num">{number.get(n.id)}</span><strong>{n.label}</strong><Evidence level={n.evidence} /></div>
          {n.detail && <p>{n.detail}</p>}
          <Sources sources={n.sources} />
        </li>
      ))}
    </ol>
  </details>
</figure>

<style>
  .flow { margin: var(--space-8) 0; }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-3); }
  .title { font-weight: 700; font-size: var(--text-h3); }
  .caption { color: var(--color-muted); font-size: var(--text-small); }
  .lanes { display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-small); }
  .lane-chip { display: inline-flex; align-items: center; gap: var(--space-1); }
  .swatch { width: 0.9em; height: 0.9em; border-radius: 2px; background: var(--lane); }

  .scroller { overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .canvas { position: relative; margin: 0 auto; }
  svg { position: absolute; inset: 0; max-width: none; }
  .link { fill: none; stroke: var(--color-muted); stroke-width: 2px; }
  .link.is-spec { stroke-dasharray: 6 5; }
  .arrow-head { fill: var(--color-muted); }

  .edge-label {
    position: absolute; transform: translate(-50%, -50%); z-index: 1;
    background: var(--color-bg); color: var(--color-ink); border: 1px solid var(--color-rule); border-radius: 4px;
    padding: 2px var(--space-2); font-size: 0.8125rem; line-height: 1.4; max-width: 90px; text-align: center; word-break: auto-phrase;
  }
  .edge-label.is-vertical { max-width: none; white-space: nowrap; }
  .edge-label.is-spec { border-style: dashed; }

  /* 場面のカード: 舞台の色は上辺の帯と見出しの小さな文字だけに使う */
  .scene {
    position: absolute; z-index: 1; display: flex; flex-direction: column; gap: var(--space-2);
    background: var(--color-bg); border: 1px solid var(--color-rule); border-radius: var(--radius);
    padding: var(--space-3) var(--space-4) var(--space-4); overflow: hidden;
  }
  .scene.is-spec { border-style: dashed; }
  .scene.kind-boss { border-color: var(--lane); }
  .scene.kind-ending, .scene.kind-start { background: color-mix(in srgb, var(--lane) 12%, var(--color-bg)); border-color: color-mix(in srgb, var(--lane) 50%, var(--color-rule)); }
  header { display: flex; align-items: center; gap: var(--space-2); }
  .no { min-width: 1.6em; height: 1.6em; display: inline-grid; place-items: center; padding: 0 0.3em;
        background: var(--color-ink); color: var(--color-bg); border-radius: 999px; font-size: 0.8125rem; line-height: 1; text-decoration: none; }
  :global(.sc-icon) { color: var(--lane); }
  .sc-sub { font-size: var(--text-small); color: var(--color-muted); }
  .sc-kind { margin-left: auto; font-size: 0.8125rem; line-height: 1; padding: 4px 8px; border: 1px solid var(--lane); border-radius: 999px; color: var(--color-ink); }
  .sc-lane { margin: 0; display: flex; align-items: center; gap: var(--space-2); font-size: 0.8125rem; color: var(--color-muted); }
  .sq { width: 0.7em; height: 0.7em; border-radius: 2px; background: var(--lane); flex: none; }
  h4 { margin: 0; font-size: 1.0625rem; font-weight: 700; line-height: 1.4; }
  .sc-detail { margin: 2px 0 0; font-size: 0.875rem; line-height: 1.65; color: var(--color-muted); line-break: strict;
               display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }

  /* スマホ: キャンバスの代わりに縦1列で並べる */
  .flow-list { display: none; list-style: none; margin: 0; padding: 0; }
  .scene.is-static { position: static; }
  .scene.is-static .sc-detail { -webkit-line-clamp: unset; display: block; }
  .sc-branch { margin: var(--space-1) 0 0; font-size: 0.8125rem; color: var(--color-ink); }
  .down { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 2.25rem; color: var(--color-muted); font-size: 1.1rem; }
  .down span { font-size: 0.8125rem; border: 1px solid var(--color-rule); border-radius: 4px; padding: 0 var(--space-2); color: var(--color-ink); }
  .down.is-spec span { border-style: dashed; }
  @media (max-width: 48rem) {
    .scroller { display: none; }
    .flow-list { display: block; }
  }
  .stops { margin-top: var(--space-4); }
  .stops summary { cursor: pointer; color: var(--color-muted); font-size: var(--text-small); }
  .stops ol { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: var(--space-4) var(--space-8); grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); }
  .stops li { padding: var(--space-3) var(--space-4); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .stop-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .stops p { margin: var(--space-1) 0 0; line-break: strict; }
</style>
