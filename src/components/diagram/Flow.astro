---
// 物語の流れ（フローチャート）。layout: list は上から下へ1本で読む形、grid は場面のカードを格子に置いて矢印で結ぶ形。
// 座標は固定の格子なので、文字幅を推定しない: カードは幅と高さが固定で、あらすじは5行まで（全文は下の一覧）。
import type { z } from 'astro/zod';
import type { flowDiagram } from '../../schema';
import Icon from '../Icon.astro';
import Evidence from '../Evidence.astro';
import Sources from '../Sources.astro';
import { makeLinker } from '../../lib/autolink';

interface Props { data: z.infer<typeof flowDiagram>; game: string; id: string; bare?: boolean }
const { data, game, id, bare = false } = Astro.props;

// カードの横の間（COL - W）は矢印のラベル用に 96px 空ける。横の矢印のラベルは2行まで、縦の矢印のラベルは1行
// 高さは、見出しが2行のときも、あらすじの最終行（compact は3行目、ほかは5行目）が切れずに入る値（上下の余白 28 + 番号の行 24 + 見出し2行 48 + 舞台の行 23 + 間 26 + あらすじ）
const [COL, ROW, W, H] = data.compact ? [304, 288, 232, 220] : [352, 328, 256, 266];
const PAD = 24;
const isGrid = data.layout === 'grid';
const isStrip = data.layout === 'strip';
const cols = Math.max(...data.nodes.map((n) => n.at[0])) + 1;
const rows = Math.max(...data.nodes.map((n) => n.at[1])) + 1;
const width = PAD * 2 + (cols - 1) * COL + W;
const height = PAD * 2 + (rows - 1) * ROW + H;
const pos = (at: [number, number]) => ({ x: PAD + at[0] * COL, y: PAD + at[1] * ROW });
const laneOf = new Map(data.lanes.map((l) => [l.id, l]));
const nodeOf = new Map(data.nodes.map((n) => [n.id, n]));
const number = new Map(data.nodes.map((n, i) => [n.id, i + 1]));
const anchor = id.replace('/', '-');
const link = await makeLinker(game);

const edges = data.edges.map((e) => {
  const a = nodeOf.get(e.from), b = nodeOf.get(e.to);
  if (!a || !b) throw new Error(`${id}: edge ${e.from}→${e.to} の場面が無い`);
  const p = pos(a.at), q = pos(b.at);
  let d: string, mid: { x: number; y: number };
  if (a.at[0] === b.at[0]) {
    // 同じ列: 縦に結ぶ
    const x = p.x + W / 2, down = q.y > p.y;
    const y1 = down ? p.y + H : p.y, y2 = down ? q.y - 2 : q.y + H + 2;
    d = `M${x},${y1} L${x},${y2}`; mid = { x, y: (y1 + y2) / 2 };
    return { ...e, d, mid, vertical: true };
  } else if (a.at[1] !== b.at[1]) {
    // 段も列も違う: 出どころの下端（上の段へ戻るときは上端）から出て、行き先の上端（下端）に入る。
    // 横の矢印（同じ段の流れ）と出入り口を分け、どの矢印がどこから来たかを見分けられるようにする
    const down = q.y > p.y;
    const x1 = p.x + W / 2, y1 = down ? p.y + H : p.y, x2 = q.x + W / 2, y2 = down ? q.y - 2 : q.y + H + 2, cy = (y1 + y2) / 2;
    d = `M${x1},${y1} C${x1},${cy} ${x2},${cy} ${x2},${y2}`;
    mid = { x: (x1 + x2) / 2, y: cy };
  } else {
    // 同じ段: 右へ進むときは右端→左端、左へ戻るときは左端→右端
    const right = q.x > p.x;
    const x1 = right ? p.x + W : p.x, y1 = p.y + H / 2, x2 = right ? q.x - 2 : q.x + W + 2, y2 = q.y + H / 2, cx = (x1 + x2) / 2;
    d = y1 === y2 ? `M${x1},${y1} L${x2},${y2}` : `M${x1},${y1} C${cx},${y1} ${cx},${y2} ${x2},${y2}`;
    mid = { x: cx, y: (y1 + y2) / 2 };
  }
  return { ...e, d, mid, vertical: false };
});
const kindLabel = { scene: '', start: '始まり', boss: '対決', ending: '結末', branch: '分岐' } as const;
// スマホ用の縦の並び: データの順に並べ、隣どうしをつなぐ矢印のラベルを間に出す
const edgeBetween = (a: string, b: string) => edges.find((e) => e.from === a && e.to === b);
const kindTag = (n: (typeof data.nodes)[number]) => (kindLabel[n.kind] && kindLabel[n.kind] !== n.sub ? kindLabel[n.kind] : '');
---
<figure class="flow">
  <figcaption>
    {!bare && <span class="title">{data.title}</span>}
    {data.caption && <span class="caption">{data.caption}</span>}
    <span class="lanes">
      {data.lanes.map((l) => <span class={`lane-chip lane-${l.color}`}><span class="swatch" aria-hidden="true"></span>{l.label}</span>)}
    </span>
  </figcaption>
  {isGrid && <div class="scroller" tabindex="0" aria-label={`${data.title}（横にスクロールできます）`}>
    <div class="canvas" style={`width:${width}px;height:${height}px`}>
      <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
        <defs>
          <marker id={`arrow-${anchor}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class="arrow-head" />
          </marker>
        </defs>
        {edges.map((e) => (
          <path d={e.d} class:list={['link', e.evidence === 'speculation' && 'is-spec']} marker-end={`url(#arrow-${anchor})`} />
        ))}
      </svg>
      {edges.filter((e) => e.label).map((e) => (
        <span class:list={['edge-label', e.vertical && 'is-vertical', e.evidence === 'speculation' && 'is-spec']} style={`left:${e.mid.x}px;top:${e.mid.y}px`}>{e.label}{e.evidence === 'speculation' && '？'}</span>
      ))}
      {data.nodes.map((n) => {
        const p = pos(n.at);
        const lane = laneOf.get(n.lane);
        if (!lane) throw new Error(`${id}: 場面 ${n.id} の lane「${n.lane}」が無い`);
        return (
          <article class:list={['scene', `lane-${lane.color}`, `kind-${n.kind}`, n.evidence === 'speculation' && 'is-spec', data.compact && 'compact-detail']}
                   style={`left:${p.x}px;top:${p.y}px;width:${W}px;height:${H}px`}>
            <header>
              <a class="no num" href={`#${anchor}-${n.id}`} aria-label={`${number.get(n.id)}: 出典へ`}>{number.get(n.id)}</a>
              {n.icon && <Icon icon={n.icon} game={game} size="1.5em" class="sc-icon" />}
              {n.sub && <span class="sc-sub">{n.sub}</span>}
              {kindTag(n) && <span class="sc-kind">{kindTag(n)}</span>}
            </header>
            <h4>{n.label}</h4>
            <p class="sc-lane"><span class="sq" aria-hidden="true"></span>{lane.label}</p>
            {n.detail && <p class="sc-detail" set:html={link(n.detail)} />}
          </article>
        );
      })}
    </div>
  </div>}
  {!isGrid && (
    <nav class:list={['overview', isStrip && data.edges.some((e) => e.label) && 'has-edge-labels']} aria-label={`${data.title}の全体`}>
      <ol style={`--count:${data.nodes.length}`}>
        {data.nodes.map((n, i) => {
          const lane = laneOf.get(n.lane)!;
          const inEdge = i > 0 ? edgeBetween(data.nodes[i - 1].id, n.id) : undefined;
          return (
            <li class:list={[`lane-${lane.color}`, `kind-${n.kind}`, n.evidence === 'speculation' && 'is-spec', inEdge?.evidence === 'speculation' && 'in-spec', i > 0 && !inEdge && 'no-in']}>
              {isStrip && inEdge?.label && <span class="ov-edge">{inEdge.label}</span>}
              <a href={`#${anchor}-${n.id}`} title={`${n.sub ?? ''} ${n.label}`}>
                <span class="ov-dot num">{number.get(n.id)}</span>
                {n.icon && <Icon icon={n.icon} game={game} size="1.25rem" class="ov-icon" />}
                {/* 小見出しは前の場面と変わるところだけ出す（「第1部」などの区切りが見え、同じ文字の繰り返しを避ける） */}
                <span class="ov-sub">{n.sub && n.sub !== data.nodes[i - 1]?.sub ? n.sub : ''}</span>
                <span class="ov-label">{n.short ?? n.label}</span>
                <span class="ov-bar" aria-hidden="true"></span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  )}
  {isStrip && (
    <ol class="notes">
      {data.nodes.map((n) => (
        <li id={`${anchor}-${n.id}`} class:list={[`lane-${laneOf.get(n.lane)!.color}`, n.evidence === 'speculation' && 'is-spec']}>
          <span class="no num">{number.get(n.id)}</span>
          <span><strong>{n.label}</strong>{n.detail && <span class="note-detail" set:html={link(n.detail)} />}</span>
        </li>
      ))}
    </ol>
  )}
  {!isStrip && <ol class:list={['flow-list', !isGrid && 'is-main']} aria-label={data.title}>
    {data.nodes.map((n, i) => {
      const lane = laneOf.get(n.lane)!;
      const next = data.nodes[i + 1];
      const e = next && edgeBetween(n.id, next.id);
      const branches = edges.filter((x) => x.from === n.id && (!next || x.to !== next.id));
      return (
        <li>
          <article class:list={['scene', 'is-static', `lane-${lane.color}`, `kind-${n.kind}`, n.evidence === 'speculation' && 'is-spec']} id={!isGrid ? `${anchor}-${n.id}` : undefined}>
            <div class="sc-head">
              <header>
                <span class="no num">{number.get(n.id)}</span>
                {n.icon && <Icon icon={n.icon} game={game} size="1.5em" class="sc-icon" />}
                {n.sub && <span class="sc-sub">{n.sub}</span>}
                {kindTag(n) && <span class="sc-kind">{kindTag(n)}</span>}
              </header>
              <h4>{n.label}</h4>
              <p class="sc-lane"><span class="sq" aria-hidden="true"></span>{lane.label}</p>
            </div>
            <div class="sc-body">
              {n.detail && <p class="sc-detail" set:html={link(n.detail)} />}
              {branches.map((b) => <p class="sc-branch"><Icon icon="lucide:corner-down-right" size="1em" class="sc-branch-icon" />{nodeOf.get(b.to)!.label}{b.label && `（${b.label}）`}</p>)}
              {!isGrid && (n.sources.length > 0 || n.evidence !== 'ingame') && (
                <div class="sc-src"><Evidence level={n.evidence} /><Sources sources={n.sources} /></div>
              )}
            </div>
          </article>
          {next && (
            <div class:list={['down', e?.evidence === 'speculation' && 'is-spec', !e && 'is-gap']}>
              {e && (
                <svg class="down-arrow" width="16" height="40" viewBox="0 0 16 40" aria-hidden="true">
                  <line x1="8" y1="2" x2="8" y2="31" />
                  <path d="M2,30 L8,38 L14,30 z" />
                </svg>
              )}
              {e?.label && <span>{e.label}</span>}
            </div>
          )}
        </li>
      );
    })}
  </ol>}
  {isGrid && <details class="stops">
    <summary>場面ごとの全文と出典</summary>
    <ol>
      {data.nodes.map((n) => (
        <li id={`${anchor}-${n.id}`} class={`lane-${laneOf.get(n.lane)!.color}`}>
          <div class="stop-head"><span class="no num">{number.get(n.id)}</span><strong>{n.label}</strong><Evidence level={n.evidence} /></div>
          {n.detail && <p set:html={link(n.detail)} />}
          <Sources sources={n.sources} />
        </li>
      ))}
    </ol>
  </details>}
</figure>

<style>
  .flow { margin: var(--space-8) 0; }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-3); }
  .title { font-weight: 700; font-size: var(--text-h3); }
  .caption { color: var(--color-muted); font-size: var(--text-small); }
  .lanes { display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-small); }
  .lane-chip { display: inline-flex; align-items: center; gap: var(--space-1); }
  .swatch { width: 0.9em; height: 0.9em; border-radius: 2px; background: var(--lane); }

  .scroller { overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .canvas { position: relative; margin: 0 auto; }
  .canvas > svg { position: absolute; inset: 0; max-width: none; }
  .link { fill: none; stroke: var(--color-muted); stroke-width: 2px; }
  .link.is-spec { stroke-dasharray: 6 5; }
  .arrow-head { fill: var(--color-muted); }

  .edge-label {
    position: absolute; transform: translate(-50%, -50%); z-index: 1;
    background: var(--color-bg); color: var(--color-ink); border: 1px solid var(--color-rule); border-radius: 4px;
    padding: 2px var(--space-2); font-size: 0.8125rem; line-height: 1.4; max-width: 90px; text-align: center; word-break: auto-phrase;
  }
  .edge-label.is-vertical { max-width: none; white-space: nowrap; }
  .edge-label.is-spec { border-style: dashed; }

  /* 場面のカード: 舞台の色は上辺の帯と見出しの小さな文字だけに使う */
  .scene {
    position: absolute; z-index: 1; display: flex; flex-direction: column; gap: var(--space-2);
    background: var(--color-bg); border: 1px solid var(--color-rule); border-radius: var(--radius);
    padding: var(--space-3) var(--space-4) var(--space-4); overflow: hidden;
  }
  .scene.is-spec { border-style: dashed; }
  .scene.kind-boss { border-color: var(--lane); }
  .scene.kind-ending, .scene.kind-start { background: color-mix(in srgb, var(--lane) 12%, var(--color-bg)); border-color: color-mix(in srgb, var(--lane) 50%, var(--color-rule)); }
  header { display: flex; align-items: center; gap: var(--space-2); }
  .no { min-width: 1.6em; height: 1.6em; display: inline-grid; place-items: center; padding: 0 0.3em;
        background: var(--color-ink); color: var(--color-bg); border-radius: 999px; font-size: 0.8125rem; line-height: 1; text-decoration: none; }
  :global(.sc-icon) { color: var(--lane); }
  .sc-sub { font-size: var(--text-small); color: var(--color-muted); }
  .sc-kind { margin-left: auto; font-size: 0.8125rem; line-height: 1; padding: 4px 8px; border: 1px solid var(--lane); border-radius: 999px; color: var(--color-ink); }
  .sc-lane { margin: 0; display: flex; align-items: center; gap: var(--space-2); font-size: 0.8125rem; color: var(--color-muted); line-height: 1.75; }
  .sq { width: 0.7em; height: 0.7em; border-radius: 2px; background: var(--lane); flex: none; }
  h4 { margin: 0; font-size: 1.0625rem; font-weight: 700; line-height: 1.4; }
  .sc-detail { margin: 2px 0 0; font-size: 0.875rem; line-height: 1.65; color: var(--color-muted); line-break: strict;
               display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }

  /* スマホ: キャンバスの代わりに縦1列で並べる */
  .flow-list { display: none; list-style: none; margin: 0; padding: 0; }
  .scene.is-static { position: static; }
  .scene.is-static .sc-detail { -webkit-line-clamp: unset; display: block; }
  .sc-head { display: flex; flex-direction: column; gap: var(--space-2); }
  .sc-branch { display: flex; align-items: center; gap: var(--space-1); margin: var(--space-1) 0 0; font-size: 0.8125rem; color: var(--color-ink); }
  /* 縦の矢印は SVG で描く（文字の「↓」は書体で形が変わり、ほかの図の矢印とそろわないため） */
  .down { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 2.5rem; }
  .down.is-gap { min-height: var(--space-4); }
  .down-arrow { flex: none; }
  .down-arrow line { stroke: var(--color-muted); stroke-width: 2; }
  .down-arrow path { fill: var(--color-muted); }
  .down.is-spec .down-arrow line { stroke-dasharray: 5 4; }
  .down span { font-size: 0.8125rem; border: 1px solid var(--color-rule); border-radius: 4px; padding: 0 var(--space-2); color: var(--color-ink); }
  .down.is-spec span { border-style: dashed; }
  @media (max-width: 48rem) {
    .scroller { display: none; }
    .flow-list { display: block; }
  }
  /* list: 上から下へ1本。広い画面では、左に章の名前と舞台、右にあらすじを置く */
  .flow-list.is-main { display: block; }
  .sc-src { margin-top: var(--space-2); display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3); }
  .sc-src :global(.sources) { margin: 0; }
  @media (min-width: 48rem) {
    .is-main .scene.is-static { display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: var(--space-2) var(--space-8); padding: var(--space-4) var(--space-6); }
    .is-main .sc-head { display: flex; flex-direction: column; gap: var(--space-2); }
    .is-main .sc-detail { margin: 0; font-size: var(--text-body); line-height: 1.75; color: var(--color-ink); max-width: var(--measure); }
    .is-main .down { justify-content: flex-start; padding-left: calc(var(--space-6) + 4px); }
  }
  /* 俯瞰の地図: 全場面を1行に並べる。番号の丸を細い線でつなぎ、下の色の棒で舞台を示す */
  .overview { overflow-x: auto; margin: 0 0 var(--space-6); padding: var(--space-4) var(--space-2) var(--space-3); background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .overview ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--count), minmax(4.25rem, 1fr)); position: relative; }
  .overview li { position: relative; }
  .overview li + li::before { content: ""; position: absolute; left: -50%; right: 50%; top: 13px; height: 2px; background: var(--color-muted); }
  /* 前の場面とつながっていない（作品が変わるなど）ときは線を引かない */
  .overview li.no-in::before { display: none; }
  .overview li.in-spec::before { background: repeating-linear-gradient(90deg, var(--color-muted) 0 6px, transparent 6px 11px); }
  /* 矢印のラベル（strip だけ）: 線の上の専用の段に置き、丸と重ならないよう列の幅の 8 割で折り返す */
  .has-edge-labels { padding-top: calc(var(--space-4) + 2.75rem); }
  .ov-edge { position: absolute; left: 0; bottom: calc(100% + 4px); transform: translateX(-50%); z-index: 2; width: max-content; max-width: 80%; text-align: center; font-size: 0.8125rem; line-height: 1.3; padding: 0 var(--space-2); word-break: auto-phrase;
             background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: 4px; color: var(--color-ink); }
  .overview li.in-spec .ov-edge { border-style: dashed; }
  .overview .is-spec .ov-dot { border-style: dashed; }
  .overview a { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding: 0 var(--space-1); text-align: center; color: var(--color-ink); text-decoration: none; height: 100%; }
  .overview a:hover .ov-label { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .ov-dot { position: relative; z-index: 1; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--color-surface); border: 3px solid var(--lane); font-size: 0.8125rem; font-weight: 700; }
  .kind-start .ov-dot, .kind-ending .ov-dot { background: var(--lane); color: var(--color-accent-ink); }
  .kind-boss .ov-dot { box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 5px var(--lane); }
  :global(.ov-icon) { color: var(--lane); margin-top: var(--space-1); }
  .ov-sub { font-size: 0.8125rem; color: var(--color-muted); line-height: 1.3; min-height: 1.3em; }
  .ov-label { font-size: 0.875rem; font-weight: 700; line-height: 1.4; word-break: auto-phrase; text-wrap: balance; overflow-wrap: anywhere; min-width: 0; max-width: 100%; }
  .ov-sub { overflow-wrap: anywhere; max-width: 100%; }
  .ov-bar { margin-top: auto; width: calc(100% - var(--space-2)); height: 6px; border-radius: 3px; background: var(--lane); }
  /* strip の下の短い説明 */
  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2) var(--space-8); grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); }
  .notes li { display: flex; gap: var(--space-3); align-items: baseline; font-size: var(--text-small); line-height: 1.7; }
  .notes li.is-spec strong::after { content: "（推測）"; font-weight: 400; color: var(--color-muted); }
  .note-detail { display: block; color: var(--color-muted); line-break: strict; }
  .scene.compact-detail .sc-detail { -webkit-line-clamp: 3; }
  .stops { margin-top: var(--space-4); }
  .stops summary { cursor: pointer; color: var(--color-muted); font-size: var(--text-small); }
  .stops ol { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: var(--space-4) var(--space-8); grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); }
  .stops li { padding: var(--space-3) var(--space-4); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .stop-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .stops p { margin: var(--space-1) 0 0; line-break: strict; }
</style>
