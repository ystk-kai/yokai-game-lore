---
// 相関図。人物を格子に置き、関係を線で結ぶ。線の色＝関係の種類、破線＝推測。
import type { z } from 'astro/zod';
import type { relationsDiagram } from '../../schema';
import { getEntry } from 'astro:content';
import Icon from '../Icon.astro';
import { refUrl } from '../../lib/refs';

interface Props { data: z.infer<typeof relationsDiagram>; game: string; id: string }
const { data, game, id } = Astro.props;

const COL = 200, ROW = 168, W = 148, H = 104, PAD = 28;
const cols = Math.max(...data.nodes.map((n) => n.at[0])) + 1;
const rows = Math.max(...data.nodes.map((n) => n.at[1])) + 1;
const width = PAD * 2 + (cols - 1) * COL + W;
const height = PAD * 2 + (rows - 1) * ROW + H;
const pos = (at: [number, number]) => ({ x: PAD + at[0] * COL, y: PAD + at[1] * ROW });
const center = (at: [number, number]) => { const p = pos(at); return { x: p.x + W / 2, y: p.y + H / 2 }; };
const nodeOf = new Map(data.nodes.map((n) => [n.id, n]));
const groupOf = new Map(data.groups.map((g) => [g.id, g]));
const kindName = { bond: '絆・協力', family: '家族', hostile: '敵対', unknown: '不明' } as const;

// 線は札の縁で止める（矢印が札に隠れないように）
const clip = (from: { x: number; y: number }, to: { x: number; y: number }) => {
  const dx = to.x - from.x, dy = to.y - from.y;
  const t = Math.min(Math.abs((W / 2 + 6) / (dx || 1e-9)), Math.abs((H / 2 + 6) / (dy || 1e-9)));
  return { x: to.x - dx * t, y: to.y - dy * t };
};
const edges = data.edges.map((e, i) => {
  const a = nodeOf.get(e.from), b = nodeOf.get(e.to);
  if (!a || !b) throw new Error(`${id}: 関係 ${e.from}→${e.to} の人物が無い`);
  const ca = center(a.at), cb = center(b.at);
  const s = clip(cb, ca), t = clip(ca, cb);
  return { ...e, i, s, t, mid: { x: (s.x + t.x) / 2, y: (s.y + t.y) / 2 } };
});
const groupBoxes = data.groups.map((g) => {
  const members = data.nodes.filter((n) => n.group === g.id).map((n) => pos(n.at));
  if (!members.length) return null;
  const x1 = Math.min(...members.map((m) => m.x)) - 14, y1 = Math.min(...members.map((m) => m.y)) - 22;
  const x2 = Math.max(...members.map((m) => m.x)) + W + 14, y2 = Math.max(...members.map((m) => m.y)) + H + 14;
  return { ...g, x: x1, y: y1, w: x2 - x1, h: y2 - y1 };
}).filter((g) => g !== null);
const anchor = id.replace('/', '-');
// dev では、characters.yaml の同じ id の人物に手元の参照画像があれば顔に使う
const chars = new Map(((await getEntry('characters', game))?.data.characters ?? []).map((c) => [c.id, c]));
const thumbOf = (nid: string) => refUrl(game, chars.get(nid)?.ref_image?.thumb);
---
<figure class="rel">
  <figcaption>
    <span class="title">{data.title}</span>
    {data.caption && <span class="caption">{data.caption}</span>}
    <span class="kinds">{Object.entries(kindName).map(([k, v]) => <span class={`kind kind-${k}`}><span class="swatch" aria-hidden="true"></span>{v}</span>)}</span>
  </figcaption>
  <div class="scroller" tabindex="0" aria-label={`${data.title}（横にスクロールできます）`}>
    <div class="canvas" style={`width:${width}px;height:${height}px`}>
      {groupBoxes.map((g) => (
        <div class={`group lane-${g.color}`} style={`left:${g.x}px;top:${g.y}px;width:${g.w}px;height:${g.h}px`}><span>{g.label}</span></div>
      ))}
      <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
        <defs>
          {Object.keys(kindName).map((k) => (
            <marker id={`arrow-${anchor}-${k}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" class={`kind-${k}`} />
            </marker>
          ))}
        </defs>
        {edges.map((e) => (
          <line x1={e.s.x} y1={e.s.y} x2={e.t.x} y2={e.t.y} class:list={['link', `kind-${e.kind}`, e.evidence === 'speculation' && 'is-spec']}
                marker-end={e.directed ? `url(#arrow-${anchor}-${e.kind})` : undefined} />
        ))}
      </svg>
      {edges.map((e) => (
        <span class={`link-label kind-${e.kind}`} style={`left:${e.mid.x}px;top:${e.mid.y}px`}>
          {e.evidence === 'speculation' ? `${e.label}？` : e.label}
        </span>
      ))}
      {data.nodes.map((n) => {
        const p = pos(n.at);
        const g = n.group ? groupOf.get(n.group) : undefined;
        return (
          <div class:list={['person', g && `lane-${g.color}`]} style={`left:${p.x}px;top:${p.y}px;width:${W}px;height:${H}px`}>
            <div class="p-body">
              {thumbOf(n.id) ? <img class="portrait-img" src={thumbOf(n.id)} alt={n.label} /> : n.icon ? <Icon icon={n.icon} game={game} size="2.5em" class="portrait" label={n.label} /> : <span class="portrait-empty" aria-hidden="true"></span>}
              <span class="name">{n.label}</span>
              {n.role && <span class="role">{n.role}</span>}
            </div>
          </div>
        );
      })}
    </div>
  </div>
  <details class="list">
    <summary>関係を文章で読む</summary>
    <ul>
      {edges.map((e) => (
        <li>{nodeOf.get(e.from)!.label} {e.directed ? '→' : '—'} {nodeOf.get(e.to)!.label}: {e.label}（{kindName[e.kind]}{e.evidence === 'speculation' ? '・推測' : ''}）</li>
      ))}
    </ul>
  </details>
</figure>

<style>
  .rel { margin: var(--space-8) 0; }
  figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-3); }
  .title { font-weight: 700; font-size: var(--text-h3); }
  .caption { color: var(--color-muted); font-size: var(--text-small); }
  .kinds { display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-small); }
  .kind { display: inline-flex; align-items: center; gap: var(--space-1); }
  .swatch { width: 1.5em; height: 3px; background: var(--k); }
  .kind-bond { --k: var(--lane-l2); } .kind-family { --k: var(--lane-l3); } .kind-hostile { --k: var(--lane-l1); } .kind-unknown { --k: var(--color-muted); }
  .kind-unknown .swatch { background: repeating-linear-gradient(90deg, var(--k) 0 4px, transparent 4px 8px); }

  .scroller { overflow-x: auto; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius); }
  .canvas { position: relative; }
  svg { position: absolute; inset: 0; max-width: none; z-index: 1; }
  .link { stroke: var(--k); stroke-width: var(--line-link); }
  .link.kind-hostile { stroke-width: 3px; }
  .link.kind-unknown, .link.is-spec { stroke-dasharray: 6 5; }
  marker path { fill: var(--k); }
  .group { position: absolute; border: 2px solid color-mix(in srgb, var(--lane) 45%, transparent); background: color-mix(in srgb, var(--lane) 6%, transparent); border-radius: 12px; }
  .group > span { position: absolute; top: 2px; left: 10px; font-size: 0.75rem; line-height: 1.4; color: var(--lane); font-weight: 700; }
  .link-label { position: absolute; transform: translate(-50%, -50%); z-index: 2; background: var(--color-surface); color: var(--color-ink);
    border: 1px solid var(--k); border-radius: 4px; padding: 0 var(--space-1); font-size: 0.8125rem; line-height: 1.5; white-space: nowrap; }
  .person { position: absolute; z-index: 3; background: var(--color-surface); border: 2px solid var(--lane, var(--color-ink)); border-radius: var(--radius); }
  .p-body { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: var(--space-1); text-align: center; }
  :global(.portrait) { color: var(--lane, var(--color-ink)); }
  .portrait-img { width: 2.75em; height: 2.75em; border-radius: 50%; object-fit: cover; border: 2px solid var(--lane, var(--color-ink)); }
  .portrait-empty { width: 2.5em; height: 2.5em; border-radius: 50%; border: 2px dashed var(--color-rule); }
  .name { font-weight: 700; font-size: var(--text-small); line-height: 1.3; }
  .role { font-size: 0.75rem; line-height: 1.3; color: var(--color-muted); }
  .list { margin-top: var(--space-3); font-size: var(--text-small); }
  .list summary { cursor: pointer; color: var(--color-muted); }
</style>
