---
// ネタバレを含む部分を覆う。範囲（scope）を必ず書く（メギド72 wiki のラベル付き折り畳みに倣う）。
// scope が無いときも .spoiler-body で包むので、呼ぶ側の CSS はどちらでも同じに書ける
interface Props { scope?: string; inline?: boolean }
const { scope, inline = false } = Astro.props;
const Tag = inline ? 'span' : 'div';
---
{scope
  ? <Tag class="spoiler-veil" data-spoiler={scope}>
      {inline
        ? <button type="button" class="spoiler-open" data-spoiler-open title={`ネタバレ: ${scope}`} aria-label={`ネタバレ（${scope}）を表示`}>伏せ字</button>
        : <button type="button" class="spoiler-open" data-spoiler-open>ネタバレ: {scope}<br />押して表示</button>}
      <Tag class="spoiler-body"><slot /></Tag>
    </Tag>
  : <Tag class="spoiler-body"><slot /></Tag>}
