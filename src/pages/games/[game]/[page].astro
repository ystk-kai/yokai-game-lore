---
import { render } from 'astro:content';
import GameLayout from '../../../layouts/GameLayout.astro';
import Diagram from '../../../components/diagram/Diagram.astro';
import Characters from '../../../components/Characters.astro';
import Theory from '../../../components/Theory.astro';
import Icon from '../../../components/Icon.astro';
import Evidence from '../../../components/Evidence.astro';
import Legend from '../../../components/Legend.astro';
import Appearances from '../../../components/diagram/Appearances.astro';
import Work from '../../../components/Work.astro';
import AutoP from '../../../components/AutoP.astro';
import AutoLi from '../../../components/AutoLi.astro';
import { gamesSorted, pagesOf, slugOf, sectionLabel } from '../../../lib/content';
import { url, file } from '../../../lib/url';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const out = [];
  for (const g of await gamesSorted()) {
    const pages = await pagesOf(g.id);
    for (const [i, p] of pages.entries()) out.push({ params: { game: g.id, page: slugOf(p.id) }, props: { g, p, pages, prev: pages[i - 1], next: pages[i + 1] } });
  }
  return out;
}
const { g, p, pages, prev, next } = Astro.props;
const { Content } = await render(p);
// 作品1本のページなら、見出しの横にその作品の画像を正方形に切り取って出す
const workTitle = p.data.work ? g.data.titles.find((t) => t.id === p.data.work) : undefined;
const coverAsset = workTitle?.cover ? (await getEntry('assets', g.id))?.data.assets.find((a) => a.id === workTitle.cover) : undefined;
const cover = coverAsset ? file(`games/${g.id}/${coverAsset.file}`) : undefined;
// 作品ページのタブ: 同じ作品の「物語の流れ」と「考察」を行き来する
const sibling = (section: string) => p.data.work ? pages.find((x) => x.data.work === p.data.work && x.data.section === section) : undefined;
const tabs = p.data.work ? [{ label: '物語の流れ', page: sibling('story') }, { label: '考察', page: sibling('theory') }].filter((x) => x.page) : [];
---
<GameLayout game={g} pages={pages} current={slugOf(p.id)} title={`${p.data.title} - ${g.data.title}`} description={p.data.description}>
  <p class="crumb">{g.data.title}<span aria-hidden="true">／</span>{sectionLabel[p.data.section]}</p>
  {cover
    ? <div class="work-head"><img class="work-thumb" src={cover} alt={coverAsset?.alt ?? ''} width="96" height="96" /><h1>{p.data.title}</h1></div>
    : <h1>{p.data.title}</h1>}
  <p class="lead">{p.data.description}</p>
  {tabs.length > 1 && (
    <nav class="work-tabs" aria-label="この作品のページ">
      {tabs.map((tb) => <a href={url(`games/${g.id}/${slugOf(tb.page!.id)}`)} class:list={[tb.page!.id === p.id && 'is-current']} aria-current={tb.page!.id === p.id ? 'page' : undefined}>{tb.label}</a>)}
    </nav>
  )}
  <article class="prose-wrap">
    <Content components={{ Diagram, Characters, Theory, Icon, Evidence, Legend, Appearances, Work, p: AutoP, li: AutoLi }} />
  </article>
  <nav class="pager" aria-label="前後のページ">
    {prev ? <a href={url(`games/${g.id}/${slugOf(prev.id)}`)}><small>前へ</small>{prev.data.title}</a> : <span />}
    {next && <a class="next" href={url(`games/${g.id}/${slugOf(next.id)}`)}><small>次へ</small>{next.data.title}</a>}
  </nav>
</GameLayout>
<style>
  .crumb { margin: 0 0 var(--space-2); font-size: var(--text-small); color: var(--color-muted); }
  .crumb span { margin: 0 var(--space-1); }
  .work-head { display: flex; align-items: center; gap: var(--space-4); }
  .work-head h1 { margin: 0; }
  .work-thumb { flex: none; width: 96px; height: 96px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--color-rule); }
  .work-tabs { display: flex; gap: var(--space-1); margin: calc(var(--space-4) * -1) 0 var(--space-8); border-bottom: 1px solid var(--color-rule); }
  .work-tabs a { padding: var(--space-2) var(--space-4); color: var(--color-muted); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .work-tabs a:hover { color: var(--color-ink); }
  .work-tabs a.is-current { color: var(--color-ink); font-weight: 700; border-bottom-color: var(--lane); }
  .lead { margin: var(--space-3) 0 var(--space-8); color: var(--color-muted); max-width: var(--measure); line-break: strict; }
  .prose-wrap > :global(p), .prose-wrap > :global(ul), .prose-wrap > :global(ol), .prose-wrap > :global(h2), .prose-wrap > :global(h3) { max-width: var(--measure); line-break: strict; overflow-wrap: anywhere; }
  .prose-wrap > :global(p) { margin: 0 0 var(--space-4); }
  .prose-wrap :global(h2) { font-size: var(--text-h2); line-height: var(--leading-tight); margin: var(--space-12) 0 var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-rule); font-feature-settings: "palt"; text-wrap: balance; }
  .prose-wrap :global(li) { margin-bottom: var(--space-2); }
  .prose-wrap :global(.theory) { margin-bottom: var(--space-6); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-top: var(--space-16); }
  .pager a { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4); border: 1px solid var(--color-rule); border-radius: var(--radius); text-decoration: none; color: var(--color-ink); }
  .pager a:hover { border-color: var(--lane); }
  .pager small { color: var(--color-muted); font-size: 0.8125rem; }
  .pager .next { text-align: right; grid-column: 2; }
</style>
