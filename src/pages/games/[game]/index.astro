---
import GameLayout from '../../../layouts/GameLayout.astro';
import Icon from '../../../components/Icon.astro';
import { gamesSorted, pagesOf, slugOf, groupBySection } from '../../../lib/content';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  return (await gamesSorted()).map((g) => ({ params: { game: g.id }, props: { g } }));
}
const { g } = Astro.props;
const pages = await pagesOf(g.id);
const groups = groupBySection(pages);
---
<GameLayout game={g} pages={pages} title={g.data.title} description={g.data.summary}>
  <header class="game-head">
    <Icon icon={g.data.icon} size="3rem" />
    <div>
      <h1>{g.data.title}</h1>
      <p class="meta">{g.data.title_ja && `${g.data.title_ja} ・ `}{g.data.developer} / {g.data.publisher} ・ <span class="num">{g.data.released}</span> 発売</p>
    </div>
  </header>
  <p class="summary">{g.data.summary}</p>
  <div class="sections">
    {groups.map((sec) => (
      <section>
        <h2><Icon icon={sec.icon} size="1.1rem" />{sec.label}</h2>
        <ul>
          {sec.pages.map((p) => (
            <li><a href={url(`games/${g.id}/${slugOf(p.id)}`)}><strong>{p.data.title}</strong><span>{p.data.description}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</GameLayout>
<style>
  .game-head { display: flex; gap: var(--space-4); align-items: center; }
  .game-head > :global(.icon) { color: var(--lane); }
  .meta { margin: var(--space-1) 0 0; color: var(--color-muted); font-size: var(--text-small); }
  .summary { max-width: var(--measure); margin: var(--space-6) 0 var(--space-12); line-break: strict; }
  .sections { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); align-items: start; }
  h2 { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-small); letter-spacing: 0.08em; color: var(--color-muted); margin: 0 0 var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  li a { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-rule); border-left: 4px solid var(--lane); border-radius: var(--radius); text-decoration: none; color: var(--color-ink); }
  li a:hover { border-color: var(--lane); }
  li a span { font-size: var(--text-small); color: var(--color-muted); line-height: 1.6; line-break: strict; }
</style>
