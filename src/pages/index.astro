---
// トップはゲーム名の一覧だけ（作者の決定。キャッチコピーや説明文を置かない）
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { gamesSorted } from '../lib/content';
import { url } from '../lib/url';
const games = await gamesSorted();
---
<Base title="Yokai Game Lore">
  <h1 class="visually-hidden">ゲーム一覧</h1>
  <ul class="games">
    {games.map((g) => (
      <li class={`lane-${g.data.color}`}>
        <a href={url(`games/${g.id}`)}>
          <Icon icon={g.data.icon} size="2rem" />
          <span class="name">{g.data.title}</span>
          {g.data.title_ja && <span class="ja">{g.data.title_ja}</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
<style>
  .games { list-style: none; padding: 0; margin: 0; max-width: 40rem; }
  .games li { border-bottom: 1px solid var(--color-rule); }
  .games a { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4) var(--space-2); color: var(--color-ink); text-decoration: none; }
  .games a:hover .name { color: var(--color-accent); }
  .games :global(.icon) { color: var(--lane); }
  .name { font-size: var(--text-h3); font-weight: 700; }
  .ja { font-size: var(--text-small); color: var(--color-muted); }
</style>
